---
import '../styles/global.css';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'fr' | 'de' | 'it' | 'es' | 'nl';
  canonical: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  alternates?: Array<{ lang: 'en' | 'fr' | 'de' | 'it' | 'es' | 'nl' | 'x-default'; href: string }>;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, lang, canonical, ogType, ogImage, twitterCard, alternates, article, schema } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      lang={lang}
      ogType={ogType}
      ogImage={ogImage}
      twitterCard={twitterCard}
      alternates={alternates}
      article={article}
      schema={schema}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
