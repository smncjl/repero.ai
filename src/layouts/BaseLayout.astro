---
import '../styles/global.css';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'fr';
  canonical: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  alternates?: Array<{ lang: 'en' | 'fr' | 'x-default'; href: string }>;
}

const { title, description, lang, canonical, ogType, ogImage, twitterCard, alternates } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      lang={lang}
      ogType={ogType}
      ogImage={ogImage}
      twitterCard={twitterCard}
      alternates={alternates}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
