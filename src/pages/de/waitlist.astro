---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import Footer from '../../components/Footer.astro';
const submitted = Astro.url.searchParams.get('submitted') === '1';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/de/waitlist', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/waitlist', site).href },
  { lang: 'fr', href: new URL('/fr/liste-attente', site).href },
  { lang: 'it', href: new URL('/it/lista-attesa', site).href },
  { lang: 'es', href: new URL('/es/lista-espera', site).href },
  { lang: 'nl', href: new URL('/nl/wachtlijst', site).href }
];
---
<BaseLayout
  lang="de"
  title="Warteliste | Repero AI"
  description="Treten Sie der frühen Beta für Repero AI bei."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="de" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Früher Zugang</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Treten Sie der frühen Beta bei.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Helfen Sie dabei, einen Europe-first KI-Arbeitsbereich zu gestalten, der auf Klarheit, Kontrolle und Portabilität basiert.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Datenkontrolle</span>
          <span class="chip">Transparenz</span>
          <span class="chip">Portabilität</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Zugang beantragen</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Erzählen Sie uns, wofür Sie es nutzen möchten.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Wir verwenden dies, um die richtige Onboarding- und Produktentwicklung zu priorisieren.</p>
        {submitted ? (
          <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-6">
            <p class="eyebrow">Eingereicht</p>
            <h3 class="mt-3 text-2xl font-semibold text-white">Sie sind auf der Warteliste.</h3>
            <p class="mt-3 text-sm leading-7 text-emerald-50/90">Ihre Anfrage wurde erhalten. Wir melden uns, sobald neue Plätze verfügbar sind.</p>
          </div>
        ) : (
          <div class="mt-6">
            <WaitlistForm lang="de" />
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer lang="de" />
</BaseLayout>
