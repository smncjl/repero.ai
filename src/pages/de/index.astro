---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/de', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en', site).href },
  { lang: 'fr', href: new URL('/fr', site).href },
  { lang: 'it', href: new URL('/it', site).href },
  { lang: 'es', href: new URL('/es', site).href },
  { lang: 'nl', href: new URL('/nl', site).href }
];
---
<BaseLayout
  lang="de"
  title="Repero AI"
  description="Repero AI hilft Benutzern, zu speichern, zu organisieren und abzurufen, was sie mit KI durchsuchen, hochladen, generieren und entscheiden."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="de" />
  <main class="page-shell pb-12">
    <section class="grid gap-8 py-8 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-14">
      <div class="space-y-6">
        <p class="eyebrow">Europe-first KI-Arbeitsbereich</p>
        <h1 class="headline">Ihre KI-Arbeit, endlich strukturiert.</h1>
        <p class="lead">Repero AI hilft Benutzern, zu speichern, zu organisieren und abzurufen, was sie mit KI durchsuchen, hochladen, generieren und entscheiden.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Früher Zugang zu Repero</a>
          <a class="btn-secondary" href="/de/use-cases">Anwendungsfälle entdecken</a>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="chip">Suchen</span>
          <span class="chip">Hochladen</span>
          <span class="chip">Generieren</span>
          <span class="chip">Entscheiden</span>
        </div>
      </div>

      <div class="surface relative overflow-hidden">
        <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-sky-500/15 blur-3xl"></div>
        <div class="absolute -left-10 bottom-0 h-40 w-40 rounded-full bg-emerald-400/10 blur-3xl"></div>
        <div class="relative space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-100">Übersicht des Arbeitsbereichs</p>
              <p class="text-xs text-slate-400">Ein ruhige Oberfläche für Gedächtnis, Gespräche und Artefakte.</p>
            </div>
            <span class="chip">Lebendiges Gedächtnis</span>
          </div>
          <div class="rounded-2xl border border-sky-500/20 bg-sky-500/10 p-4">
            <p class="text-sm font-semibold text-sky-100">Wichtiges festhalten</p>
            <p class="mt-1 text-sm text-slate-300">Suchen, Hochladen, Entscheidungen und generierte Inhalte bleiben sichtbar und wiederverwendbar.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Sitzungen</p>
              <p class="mt-2 text-2xl font-bold text-white">12</p>
            </div>
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Artefakte</p>
              <p class="mt-2 text-2xl font-bold text-white">248</p>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>Kürzliche Elemente</span>
              <span>Nach Kontext organisiert</span>
            </div>
            <div class="mt-3 space-y-2">
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Projektnotiz · Produktentscheidungen</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Prompt-Satz · wiederverwendbare Workflow</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Hochgeladene Dokumente · indiziert und durchsuchbar</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="feature-card">
        <p class="eyebrow">Problem</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Nützliche KI-Arbeit geht verloren.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Lange Chats, gemischte Artefakte und Ad-hoc-Notizen machen es schwer, auf das wirklich Wertvolle zurückzugreifen.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Lösung</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Eine ruhige, organisierte Ebene.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Repero AI bringt Gespräche, Dokumente und generierte Ausgaben in einen strukturierten Arbeitsbereich.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Richtung</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Europa-first von Design.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Auf Kontrolle, Transparenz und Portabilität aufgebaut, damit das Produkt vertrauenswürdig und langlebig wirkt.</p>
      </article>
    </section>
  </main>
  <Footer lang="de" />
</BaseLayout>
