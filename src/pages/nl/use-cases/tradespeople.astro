---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/nl/use-cases/tradespeople', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/use-cases/tradespeople', site).href },
  { lang: 'fr', href: new URL('/fr/cas-usages/techniciens', site).href },
  { lang: 'de', href: new URL('/de/use-cases/tradespeople', site).href },
  { lang: 'it', href: new URL('/it/use-cases/tradespeople', site).href },
  { lang: 'es', href: new URL('/es/use-cases/tradespeople', site).href }
];
---
<UseCasePage
  lang="nl"
  canonical={canonical}
  title="Handwerkers en technici"
  description="Veldkennis en documentatie vastleggen."
  tags={["technici", "reparateur", "HVAC-installateurs", "werk op locatie", "onderhoud", "veldservice"]}
  items={["handleidingen", "installatiedocumentatie", "interventienotities", "leveranciersdocumentatie", "apparaatspecifieke kennis"]}
  exampleTitle="Concreet voorbeeld"
  exampleIntro="Veldwerk is vloeiender wanneer de handleiding, de interventienotities en de checklist in één project blijven."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "Ik open de apparaat handleiding en maak een project rond dat apparaat in Repero AI.",
    "Ik voeg interventienotities, leveranciersdocumenten en de volgende onderhoudsstappen toe.",
    "Ik vraag Repero AI om de werkchecklist voor de volgende sitebezoek voor te bereiden.",
    "Ik sla die checklist op als een artefact gekoppeld aan de apparaatcontext.",
    "Bij de volgende interventie heropen ik het artefact en volg ik hetzelfde plan in plaats van opnieuw vanaf nul te starten."
  ]}
/>
