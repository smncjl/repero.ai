---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/nl/use-cases/everyday', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/use-cases/everyday', site).href },
  { lang: 'fr', href: new URL('/fr/cas-usages/quotidien', site).href },
  { lang: 'de', href: new URL('/de/use-cases/everyday', site).href },
  { lang: 'it', href: new URL('/it/use-cases/everyday', site).href },
  { lang: 'es', href: new URL('/es/use-cases/everyday', site).href }
];
---
<UseCasePage
  lang="nl"
  canonical={canonical}
  title="Dagelijks gebruik"
  description="Persoonlijk werk georganiseerd houden."
  tags={["persoonlijke organisatie", "reisplanning", "familieprojecten", "papierwerk", "aankoopvergelijking", "huisverbetering"]}
  items={["stadsreisplanning", "belangrijke aankoopvergelijking", "familieprojecten", "papierwerk en persoonlijke documenten", "huisverbeteringsplanning"]}
  exampleTitle="Concreet voorbeeld"
  exampleIntro="Een stadsreis is makkelijker wanneer het gesprek, de recherche en de beslissingen in hetzelfde project blijven."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "Ik start een gesprek om een stadsreis naar Madrid te plannen.",
    "Ik zet dat gesprek om naar een project en houd de reiscontext daar.",
    "Ik zoek naar attracties en sla de kortlijst binnen het project op.",
    "Ik kijk naar betalingsmethodes, accommodatiehulp en lokale gerechten om te proberen, en sla elk resultaat op als een artefact.",
    "Later heropen ik het project en vind ik het volledige reisgesprek op één plek."
  ]}
/>
