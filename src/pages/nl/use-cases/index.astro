---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/nl/use-cases', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/use-cases', site).href },
  { lang: 'fr', href: new URL('/fr/cas-usages', site).href },
  { lang: 'de', href: new URL('/de/use-cases', site).href },
  { lang: 'it', href: new URL('/it/use-cases', site).href },
  { lang: 'es', href: new URL('/es/use-cases', site).href }
];
---
<BaseLayout
  lang="nl"
  title="Gebruiksscenario's | Repero AI"
  description="Gebruiksscenario's voor Repero AI."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="nl" />
  <main class="page-shell py-10">
    <section class="surface">
      <p class="eyebrow">Gebruiksscenario's</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Kies de workflow die past bij hoe je werkt.</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Repero AI behoudt dezelfde context gekoppeld aan het werk, of je nu persoonlijke taken afhandelt, technische leveringen, datanalyse of veldwerk uitvoert.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/nl/use-cases/everyday">Dagelijks gebruik</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/nl/use-cases/developers">Ontwikkelaars</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/nl/use-cases/data-teams">Datateams</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/nl/use-cases/tradespeople">Handwerkers & technici</a>
      </div>
    </section>
  </main>
  <Footer lang="nl" />
</BaseLayout>
