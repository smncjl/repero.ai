---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/nl/use-cases/data-teams', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/use-cases/data-teams', site).href },
  { lang: 'fr', href: new URL('/fr/cas-usages/data', site).href },
  { lang: 'de', href: new URL('/de/use-cases/data-teams', site).href },
  { lang: 'it', href: new URL('/it/use-cases/data-teams', site).href },
  { lang: 'es', href: new URL('/es/use-cases/data-teams', site).href }
];
---
<UseCasePage
  lang="nl"
  canonical={canonical}
  title="Datateams"
  description="Structuur voor analyse- en transformatiekennis."
  tags={["datateams", "SQL", "PySpark", "dbt", "bedrijfsregels", "data-analyse"]}
  items={["datasets", "SQL / PySpark / dbt snippets", "bedrijfsregels", "transformatielogica", "analysenotities"]}
  exampleTitle="Concreet voorbeeld"
  exampleIntro="Een dataproject is makkelijker te leveren wanneer de broncontext, analyse en follow-up werk samen blijven."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "Ik ontvang een nieuw dataset en maak een project in Repero AI met de broncontext.",
    "Ik capture de bedrijfsanalyse, de KPI-definities en de veronderstellingen achter de cijfers.",
    "Ik vraag Repero AI om de follow-up werk nodig om het datamodel te leveren samen te stellen.",
    "Ik sla de resulterende taaklijst op als een productartefact zodat het hele team het kan hergebruiken.",
    "Tijdens levering heropen ik het artefact om zowel de regels als de acties die al zijn overeengekomen te controleren."
  ]}
/>
