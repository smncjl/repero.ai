---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import Footer from '../../components/Footer.astro';
const submitted = Astro.url.searchParams.get('submitted') === '1';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/nl/waitlist', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/waitlist', site).href },
  { lang: 'fr', href: new URL('/fr/liste-attente', site).href },
  { lang: 'de', href: new URL('/de/waitlist', site).href },
  { lang: 'it', href: new URL('/it/lista-attesa', site).href },
  { lang: 'es', href: new URL('/es/lista-espera', site).href }
];
---
<BaseLayout
  lang="nl"
  title="Wachtlijst | Repero AI"
  description="Word lid van de wachtlijst voor Repero AI."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="nl" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Early access</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Word lid van de vroege beta.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Help bij het vormgeven van een Europees eerste AI werkruimte gebaseerd op duidelijkheid, controle en portabiliteit.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Gegevensbeheer</span>
          <span class="chip">Transparantie</span>
          <span class="chip">Portabiliteit</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Toegang aanvragen</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Vertel ons voor wat je het wilt gebruiken.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">We gebruiken dit om de juiste onboarding en productrichting te prioriteren.</p>
        {submitted ? (
          <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-6">
            <p class="eyebrow">Verstuurd</p>
            <h3 class="mt-3 text-2xl font-semibold text-white">Je staat op de wachtlijst.</h3>
            <p class="mt-3 text-sm leading-7 text-emerald-50/90">Je verzoek is ontvangen. We volgen op wanneer de volgende plekken beschikbaar zijn.</p>
          </div>
        ) : (
          <div class="mt-6">
            <WaitlistForm lang="nl" />
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer lang="nl" />
</BaseLayout>
