---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/nl/waitlist', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/waitlist', site).href },
  { lang: 'fr', href: new URL('/fr/liste-attente', site).href },
  { lang: 'de', href: new URL('/de/waitlist', site).href },
  { lang: 'it', href: new URL('/it/waitlist', site).href },
  { lang: 'es', href: new URL('/es/waitlist', site).href }
];
---
<BaseLayout
  lang="nl"
  title="Access | Repero AI"
  description="Access Repero AI now."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="nl" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Toegang</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Access Repero AI now.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Repero AI is now available at <a href="https://app.repero.ai" class="text-emerald-400 hover:text-emerald-300">app.repero.ai</a>.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Data control</span>
          <span class="chip">Transparency</span>
          <span class="chip">Portability</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Access now</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Ready to get started?</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Click below to access the platform immediately.</p>
        <div class="mt-6">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Repero AI openen</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="nl" />
</BaseLayout>
