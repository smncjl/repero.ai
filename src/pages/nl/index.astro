---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/nl', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en', site).href },
  { lang: 'fr', href: new URL('/fr', site).href },
  { lang: 'de', href: new URL('/de', site).href },
  { lang: 'it', href: new URL('/it', site).href },
  { lang: 'es', href: new URL('/es', site).href }
];
---
<BaseLayout
  lang="nl"
  title="Repero AI"
  description="Repero AI helpt gebruikers om te bewaren, organiseren en terug te halen wat ze zoeken, uploaden, genereren en beslissen met AI."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="nl" />
  <main class="page-shell pb-12">
    <section class="grid gap-8 py-8 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-14">
      <div class="space-y-6">
        <p class="eyebrow">Europees eerste AI werkruimte</p>
        <h1 class="headline">Uw AI werk, eindelijk georganiseerd.</h1>
        <p class="lead">Repero AI helpt gebruikers om te bewaren, organiseren en terug te halen wat ze zoeken, uploaden, genereren en beslissen met AI.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Vroege toegang tot Repero</a>
          <a class="btn-secondary" href="/nl/use-cases">Verken gebruiksscenario's</a>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="chip">Zoeken</span>
          <span class="chip">Uploaden</span>
          <span class="chip">Genereren</span>
          <span class="chip">Besluiten</span>
        </div>
      </div>

      <div class="surface relative overflow-hidden">
        <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-sky-500/15 blur-3xl"></div>
        <div class="absolute -left-10 bottom-0 h-40 w-40 rounded-full bg-emerald-400/10 blur-3xl"></div>
        <div class="relative space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-100">Overzicht werkruimte</p>
              <p class="text-xs text-slate-400">Een kalm oppervlak voor geheugen, gesprekken en artefacten.</p>
            </div>
            <span class="chip">Live geheugen</span>
          </div>
          <div class="rounded-2xl border border-sky-500/20 bg-sky-500/10 p-4">
            <p class="text-sm font-semibold text-sky-100">Vang op wat belangrijk is</p>
            <p class="mt-1 text-sm text-slate-300">Zoekopdrachten, uploads, beslissingen en gegenereerde inhoud blijven zichtbaar en herbruikbaar.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Sessies</p>
              <p class="mt-2 text-2xl font-bold text-white">12</p>
            </div>
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Artefacten</p>
              <p class="mt-2 text-2xl font-bold text-white">248</p>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>Recente items</span>
              <span>Gestructureerd op context</span>
            </div>
            <div class="mt-3 space-y-2">
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Projectnotitie · productbeslissingen</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Prompt set · herbruikbare workflow</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Geüpload document · geïndexeerd en doorzoekbaar</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="feature-card">
        <p class="eyebrow">Probleem</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Nuttig AI werk gaat verloren.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Lange chats, gemengde artefacten en ad-hoc notities maken het moeilijk om terug te kijken naar wat daadwerkelijk waardevol was.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Oplossing</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Een rustige, georganiseerde laag.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Repero AI brengt gesprekken, documenten en gegenereerde uitvoer naar een gestructureerde werkruimte.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Richting</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Europees eerst ontworpen.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Gebouwd rond controle, transparantie en portabiliteit zodat het product vertrouwen en duurzaamheid geeft.</p>
      </article>
    </section>
  </main>
  <Footer lang="nl" />
</BaseLayout>
