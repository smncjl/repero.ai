---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr/liste-attente', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/waitlist', site).href }];
---
<BaseLayout
  lang="fr"
  title="Accès | Repero AI"
  description="Accédez à Repero AI maintenant."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="fr" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Early access</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Accédez à Repero AI maintenant.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Repero AI est désormais disponible pour un accès anticipé sur <a href="https://app.repero.ai" class="text-emerald-400 hover:text-emerald-300">app.repero.ai</a>.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Contrôle des données</span>
          <span class="chip">Transparence</span>
          <span class="chip">Portabilité</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Accès maintenant</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Prêt à commencer ?</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Cliquez ci-dessous pour accéder immédiatement à la plateforme.</p>
        <div class="mt-6">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Accéder à app.repero.ai</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="fr" />
</BaseLayout>
