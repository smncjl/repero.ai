---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
const submitted = Astro.url.searchParams.get('submitted') === '1';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr/liste-attente', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/waitlist', site).href }];
---
<BaseLayout
  lang="fr"
  title="Liste d'attente | Repero AI"
  description="Rejoindre la bêta Repero AI."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="fr" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Accès anticipé</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Rejoindre la bêta.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Aidez-nous à construire un espace de travail IA européen pensé pour la clarté, le contrôle et la portabilité.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Contrôle des données</span>
          <span class="chip">Transparence</span>
          <span class="chip">Portabilité</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Demande d’accès</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Dites-nous à quoi vous voulez l’utiliser.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Nous nous en servirons pour prioriser le bon parcours d’accueil et les bonnes priorités produit.</p>
        {submitted ? (
          <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-6">
            <p class="eyebrow">Envoyé</p>
            <h3 class="mt-3 text-2xl font-semibold text-white">Vous êtes sur la liste d’attente.</h3>
            <p class="mt-3 text-sm leading-7 text-emerald-50/90">Votre demande a bien été reçue. Nous vous recontacterons lorsque de nouveaux accès seront ouverts.</p>
          </div>
        ) : (
          <div class="mt-6">
            <WaitlistForm lang="fr" />
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer lang="fr" />
</BaseLayout>
