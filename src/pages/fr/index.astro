---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr', site).href;
const alternates = [{ lang: 'en', href: new URL('/en', site).href }];
---
<BaseLayout
  lang="fr"
  title="Repero AI | Votre travail avec l’IA, enfin organisé"
  description="Espace de travail IA européen pour centraliser, structurer et retrouver vos conversations, documents et artefacts."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="fr" />
  <main class="page-shell pb-12">
    <section class="grid gap-8 py-8 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-14">
      <div class="space-y-6">
        <p class="eyebrow">Espace de travail IA européen</p>
        <h1 class="headline">Votre travail avec l’IA, enfin organisé.</h1>
        <p class="lead">Repero AI aide à centraliser, structurer et retrouver vos recherches, vos imports, vos contenus générés et vos décisions.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Accès anticipé à Repero</a>
          <a class="btn-secondary" href="/fr/cas-usages">Voir les cas d’usages</a>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="chip">Recherche</span>
          <span class="chip">Import</span>
          <span class="chip">Génération</span>
          <span class="chip">Décision</span>
        </div>
      </div>

      <div class="surface relative overflow-hidden p-3">
        <img
          src="/vue-artifact-contexte-travail.png"
          alt="Capture d’écran de Repero AI montrant la vue artefacts, le contexte actif, les sources et la recherche."
          class="w-full rounded-2xl border border-slate-800 object-cover shadow-[0_22px_60px_rgba(2,132,199,0.18)]"
          width="1202"
          height="704"
          loading="eager"
        />
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="feature-card">
        <p class="eyebrow">Problème</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Le travail utile se perd.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Les discussions longues, les artefacts mélangés et les notes éparses rendent la reprise difficile.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Solution</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Une couche organisée et intuitive.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Repero AI rassemble conversations, documents et contenus générés dans un espace structuré.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Direction</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Européenne par conception.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Conçu pour le contrôle, la transparence et la portabilité afin de renforcer la confiance.</p>
      </article>
    </section>
  </main>
  <Footer lang="fr" />
</BaseLayout>
