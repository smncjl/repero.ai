---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr', site).href;
const alternates = [{ lang: 'en', href: new URL('/en', site).href }];
---
<BaseLayout
  lang="fr"
  title="Repero AI | Votre travail avec l’IA, enfin organisé"
  description="Espace de travail IA européen pour centraliser, structurer et retrouver vos conversations, documents et artefacts."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="fr" />
  <main class="page-shell pb-12">
    <section class="grid gap-8 py-8 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-14">
      <div class="space-y-6">
        <p class="eyebrow">Espace de travail IA européen</p>
        <h1 class="headline">Votre travail avec l’IA, enfin organisé.</h1>
        <p class="lead">Repero AI aide à centraliser, structurer et retrouver vos recherches, vos imports, vos contenus générés et vos décisions.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/fr/liste-attente">Rejoindre la bêta</a>
          <a class="btn-secondary" href="/fr/cas-usages">Voir les cas d’usages</a>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="chip">Recherche</span>
          <span class="chip">Import</span>
          <span class="chip">Génération</span>
          <span class="chip">Décision</span>
        </div>
      </div>

      <div class="surface relative overflow-hidden">
        <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-sky-500/15 blur-3xl"></div>
        <div class="absolute -left-10 bottom-0 h-40 w-40 rounded-full bg-emerald-400/10 blur-3xl"></div>
        <div class="relative space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-100">Vue d’ensemble</p>
              <p class="text-xs text-slate-400">Un espace intelligent pour mémoire, conversations et artefacts.</p>
            </div>
            <span class="chip">Mémoire active</span>
          </div>
          <div class="rounded-2xl border border-sky-500/20 bg-sky-500/10 p-4">
            <p class="text-sm font-semibold text-sky-100">Capturer l’essentiel</p>
            <p class="mt-1 text-sm text-slate-300">Les recherches, imports, décisions et contenus générés restent visibles et réutilisables.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Sessions</p>
              <p class="mt-2 text-2xl font-bold text-white">12</p>
            </div>
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Artefacts</p>
              <p class="mt-2 text-2xl font-bold text-white">248</p>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>Éléments récents</span>
              <span>Organisés par contexte</span>
            </div>
            <div class="mt-3 space-y-2">
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Note projet · décisions produit</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Pack de prompts · workflow réutilisable</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Document importé · indexé et recherché</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="feature-card">
        <p class="eyebrow">Problème</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Le travail utile se perd.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Les discussions longues, les artefacts mélangés et les notes éparses rendent la reprise difficile.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Solution</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Une couche organisée et intuitive.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Repero AI rassemble conversations, documents et contenus générés dans un espace structuré.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Direction</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Européenne par conception.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Conçu pour le contrôle, la transparence et la portabilité afin de renforcer la confiance.</p>
      </article>
    </section>
  </main>
  <Footer lang="fr" />
</BaseLayout>
