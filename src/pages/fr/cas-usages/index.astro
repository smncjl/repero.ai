---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---
<BaseLayout lang="fr" title="Cas d'usages | Repero AI" description="Cas d'usages Repero AI.">
  <Header lang="fr" />
  <main class="page-shell py-10">
    <section class="surface">
      <p class="eyebrow">Cas d’usages</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Choisissez le flux qui correspond à votre façon de travailler.</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Repero AI est conçu pour garder une trace exploitable de ce qui compte, que vous construisiez, recherchiez ou gériez des tâches du quotidien.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/quotidien">Usage quotidien</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/developpeurs">Développeurs</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/data">Équipes data</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/techniciens">Techniciens</a>
      </div>
    </section>
  </main>
  <Footer lang="fr" />
</BaseLayout>
