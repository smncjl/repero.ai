---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr/use-cases/developers', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/use-cases/developers', site).href },
  { lang: 'de', href: new URL('/de/use-cases/developers', site).href },
  { lang: 'it', href: new URL('/it/use-cases/developers', site).href },
  { lang: 'es', href: new URL('/es/use-cases/developers', site).href },
  { lang: 'nl', href: new URL('/nl/use-cases/developers', site).href }
];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Développeurs"
  description="Gardez le travail technique aligné entre l'analyse, la documentation et l'implémentation."
  tags={["développeurs", "équipes techniques", "architecture", "débogage", "documentation technique", "prompts"]}
  items={["extraits de code", "analyse des exigences", "notes d'architecture", "sessions de débogage", "documentation technique", "prompts réutilisables et décisions"]}
  exampleTitle="Exemple concret"
  exampleIntro="Un projet technique reste utilisable lorsque l'analyse, la documentation et les tâches vivent toutes au même endroit."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "J'importe l'analyse métier et crée un projet autour de celle-ci dans Repero AI.",
    "J'actualise la documentation de la plateforme avec les exigences, les hypothèses et les décisions ouvertes.",
    "Je demande à Repero AI de préparer la checklist d'implémentation pour le prochain sprint.",
    "Je sauvegarde cette checklist en tant qu'artefact produit afin que l'équipe puisse réutiliser le même contexte.",
    "Quand je commence à coder, je suis l'artefact au lieu de rouvrir des conversations dispersées."
  ]}
/>
