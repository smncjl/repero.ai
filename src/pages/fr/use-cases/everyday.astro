---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr/use-cases/everyday', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases/everyday', site).href }];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Usage quotidien"
  description="Gardez votre travail personnel organisé."
  tags={["organisation personnelle", "planification de voyage", "projets familiaux", "papier", "comparaison d'achat", "rénovation de maison"]}
  items={["planification d'un voyage en ville", "comparaison d'achat importante", "projets familiaux", "papier et documents personnels", "planification de rénovation de maison"]}
  exampleTitle="Exemple concret"
  exampleIntro="Un voyage en ville est plus facile quand la conversation, la recherche et les décisions restent dans le même projet."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "Je démarre une conversation pour planifier un voyage en ville à Madrid.",
    "Je transforme cette conversation en projet et garde le contexte du voyage là-bas.",
    "Je cherche les points d'intérêt et sauvegarde la liste de sélection à l'intérieur du projet.",
    "Je cherche les méthodes de paiement, l'aide pour l'hébergement et les plats locaux à essayer, puis je sauvegarde chaque résultat comme un artefact.",
    "Plus tard, je rouvre le projet et trouve le fil complet du voyage en un seul endroit."
  ]}
/>
