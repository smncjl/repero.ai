---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr/use-cases/tradespeople', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases/tradespeople', site).href }];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Artisans et techniciens"
  description="Capturez les connaissances et la documentation sur le terrain."
  tags={["techniciens", "techniciens de réparation", "installateurs HVAC", "travail sur site", "maintenance", "service sur site"]}
  items={["manuels", "documentation d'installation", "notes d'intervention", "documentation du fournisseur", "connaissances spécifiques à l'équipement"]}
  exampleTitle="Exemple concret"
  exampleIntro="Le travail sur site est plus fluide quand le manuel, les notes d'intervention et la checklist restent dans un seul projet."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "J'ouvre le manuel de l'équipement et crée un projet autour de cet équipement dans Repero AI.",
    "J'ajoute les notes d'intervention, les documents du fournisseur et les étapes de maintenance suivantes.",
    "Je demande à Repero AI de préparer la checklist de travail pour la prochaine visite sur site.",
    "Je stocke cette checklist en tant qu'artefact lié au contexte de l'équipement.",
    "Lors de la prochaine intervention, je rouvre l'artefact et suis le même plan au lieu de repartir de zéro."
  ]}
/>
