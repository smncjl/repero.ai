---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/fr/use-cases/data-teams', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases/data-teams', site).href }];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Équipes de données"
  description="Structurez vos connaissances d'analyse et de transformation."
  tags={["équipes de données", "SQL", "PySpark", "dbt", "règles métier", "analyse de données"]}
  items={["ensembles de données", "extraits SQL / PySpark / dbt", "règles métier", "logique de transformation", "notes d'analyse"]}
  exampleTitle="Exemple concret"
  exampleIntro="Un projet de données est plus facile à livrer quand le contexte source, l'analyse et le travail de suivi restent ensemble."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "Je reçois un nouveau jeu de données et crée un projet dans Repero AI avec le contexte source.",
    "Je capture l'analyse métier, les définitions des KPI et les hypothèses derrière les chiffres.",
    "Je demande à Repero AI d'assembler le travail de suivi nécessaire pour livrer le modèle de données.",
    "Je sauvegarde la liste de tâches résultante en tant qu'artefact produit afin que toute l'équipe puisse le réutiliser.",
    "Pendant la livraison, je rouvre l'artefact pour vérifier à la fois les règles et les actions déjà convenues."
  ]}
/>
