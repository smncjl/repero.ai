---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { buildBlogIndexPath, buildBlogPostPath, formatBlogDate, getPublishedBlogPosts, getReadingTimeMinutes } from '../../../lib/blog';

const site = Astro.site?.href || 'https://repero.ai';
const posts = await getPublishedBlogPosts('fr');
const canonical = new URL(buildBlogIndexPath('fr'), site).href;
---
<BaseLayout
  lang="fr"
  title="Le blog Repero AI | IA, mémoire de travail et organisation"
  description="Analyses et retours d’expérience sur l’IA au travail, la mémoire documentaire, les conversations et les artefacts à ne pas perdre."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
>
  <Header lang="fr" />
  <main class="page-shell pb-12">
    <section class="section-shell px-6 py-10 md:px-10 md:py-14">
      <div class="max-w-3xl space-y-5">
        <p class="eyebrow">Blog</p>
        <h1 class="headline text-4xl md:text-5xl">Le blog Repero AI</h1>
        <p class="lead max-w-3xl text-lg md:text-xl">
          Des articles sur le chaos des conversations IA, la mémoire de travail et la manière de retrouver ce qui compte vraiment.
        </p>
      </div>
    </section>

    <section class="mt-8 grid gap-5">
      {posts.map((post) => {
        const href = buildBlogPostPath(post);
        const readingTime = getReadingTimeMinutes(post.body);

        return (
          <article class="feature-card">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-400">
              <span class="chip">{post.data.category}</span>
              <span>{formatBlogDate(post.data.pubDate)}</span>
              <span>{readingTime} min de lecture</span>
            </div>
            <h2 class="mt-4 text-2xl font-semibold text-white">
              <a class="hover:text-sky-300" href={href}>{post.data.title}</a>
            </h2>
            <p class="mt-3 max-w-3xl text-base leading-7 text-slate-300">{post.data.description}</p>
            <div class="mt-5">
              <a class="btn-secondary" href={href}>Lire l’article</a>
            </div>
          </article>
        );
      })}
    </section>
  </main>
  <Footer lang="fr" />
</BaseLayout>
