---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---
<BaseLayout lang="en" title="EN Use Cases | Repero AI" description="Use cases for Repero AI.">
  <Header lang="en" />
  <main class="page-shell py-10">
    <section class="surface">
      <p class="eyebrow">Use cases</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Pick the flow that matches how you work.</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Repero AI is designed to keep a clean record of what matters, whether you are building, researching or handling everyday work.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/en/use-cases/everyday">Everyday users</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/en/use-cases/developers">Developers</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/en/use-cases/data-teams">Data teams</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/en/use-cases/tradespeople">Tradespeople & technicians</a>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>
