---
import UseCasePage from '../../../components/UseCasePage.astro';
---
<UseCasePage
  lang="en"
  title="Data teams"
  description="Structure analysis and transformation knowledge."
  items={["datasets", "SQL / PySpark / dbt snippets", "business rules", "transformation logic", "analysis notes"]}
  exampleTitle="Concrete example"
  exampleIntro="A data team can turn one investigation into a reusable operating record."
  exampleSteps={[
    "I receive a new dataset and store the source context in Repero AI.",
    "I capture the business analysis, the KPI definitions and the assumptions behind the numbers.",
    "I ask Repero AI to assemble the follow-up work needed to ship the data model.",
    "The resulting task list is saved as a product artefact so the whole team can reuse it.",
    "During delivery, I can reopen the artefact to check both the rules and the actions already agreed."
  ]}
/>
