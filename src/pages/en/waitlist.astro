---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
const submitted = Astro.url.searchParams.get('submitted') === '1';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/en/waitlist', site).href;
const alternates = [{ lang: 'fr', href: new URL('/fr/liste-attente', site).href }];
---
<BaseLayout
  lang="en"
  title="Waitlist | Repero AI"
  description="Join Repero AI early beta."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="en" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Early access</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Join the early beta.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Help shape a European-first AI workspace built around clarity, control and portability.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Data control</span>
          <span class="chip">Transparency</span>
          <span class="chip">Portability</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Request access</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Tell us what you want to use it for.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">We’ll use this to prioritise the right onboarding and product direction.</p>
        {submitted ? (
          <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-6">
            <p class="eyebrow">Submitted</p>
            <h3 class="mt-3 text-2xl font-semibold text-white">You’re on the waitlist.</h3>
            <p class="mt-3 text-sm leading-7 text-emerald-50/90">Your request has been received. We’ll follow up when the next spots open.</p>
          </div>
        ) : (
          <div class="mt-6">
            <WaitlistForm lang="en" />
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>
