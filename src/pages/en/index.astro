---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout lang="en" title="Repero AI | Your AI work, finally organized" description="European-first AI workspace to keep, organize and retrieve AI work.">
  <Header lang="en" />
  <main class="mx-auto max-w-6xl px-6">
    <section class="py-16"><h1 class="text-4xl font-bold">Your AI work, finally organized.</h1><p class="mt-4 max-w-2xl text-lg">Repero AI helps users keep, organize and retrieve what they search, upload, generate and decide with AI.</p><div class="mt-6 flex gap-3"><a class="btn-primary" href="/en/waitlist">Join early beta</a><a class="btn-secondary" href="/en/use-cases">Explore use cases</a></div></section>
    <section class="card"><h2 class="text-2xl font-semibold">Problem</h2><p class="mt-2">Useful AI work gets lost in long chat histories.</p></section>
    <section class="card mt-6"><h2 class="text-2xl font-semibold">Solution</h2><p class="mt-2">Repero AI organizes conversations, documents and generated artefacts.</p></section>
    <section class="card mt-6"><h2 class="text-2xl font-semibold">European-first direction</h2><p class="mt-2">Designed for users who want to keep control of their AI work, with data control, transparency, portability, and a sovereign-compatible direction.</p></section>
  </main>
  <Footer lang="en" />
</BaseLayout>
