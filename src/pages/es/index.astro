---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/es', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en', site).href },
  { lang: 'fr', href: new URL('/fr', site).href },
  { lang: 'de', href: new URL('/de', site).href },
  { lang: 'it', href: new URL('/it', site).href },
  { lang: 'nl', href: new URL('/nl', site).href }
];
---
<BaseLayout
  lang="es"
  title="Repero AI"
  description="Repero AI ayuda a los usuarios a guardar, organizar y recuperar lo que buscan, cargan, generan y deciden con IA."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="es" />
  <main class="page-shell pb-12">
    <section class="grid gap-8 py-8 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-14">
      <div class="space-y-6">
        <p class="eyebrow">Espacio de trabajo IA primero europeo</p>
        <h1 class="headline">Tu trabajo con IA, finalmente organizado.</h1>
        <p class="lead">Repero AI ayuda a los usuarios a guardar, organizar y recuperar lo que buscan, cargan, generan y deciden con IA.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Acceder a app.repero.ai</a>
          <a class="btn-secondary" href="/es/use-cases">Explora casos de uso</a>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="chip">Búsqueda</span>
          <span class="chip">Carga</span>
          <span class="chip">Generación</span>
          <span class="chip">Decisión</span>
        </div>
      </div>

      <div class="surface relative overflow-hidden">
        <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-sky-500/15 blur-3xl"></div>
        <div class="absolute -left-10 bottom-0 h-40 w-40 rounded-full bg-emerald-400/10 blur-3xl"></div>
        <div class="relative space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-100">Resumen del espacio de trabajo</p>
              <p class="text-xs text-slate-400">Una superficie tranquila para la memoria, las conversaciones y los artefactos.</p>
            </div>
            <span class="chip">Memoria activa</span>
          </div>
          <div class="rounded-2xl border border-sky-500/20 bg-sky-500/10 p-4">
            <p class="text-sm font-semibold text-sky-100">Captura lo que importa</p>
            <p class="mt-1 text-sm text-slate-300">Las búsquedas, cargas, decisiones y contenido generado permanecen visibles y reutilizables.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Sesiones</p>
              <p class="mt-2 text-2xl font-bold text-white">12</p>
            </div>
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Artefactos</p>
              <p class="mt-2 text-2xl font-bold text-white">248</p>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>Elementos recientes</span>
              <span>Organizados por contexto</span>
            </div>
            <div class="mt-3 space-y-2">
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Nota de proyecto · decisiones del producto</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Conjunto de prompts · flujo de trabajo reutilizable</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Documento cargado · indexado y buscable</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="feature-card">
        <p class="eyebrow">Problema</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">El trabajo útil con IA se pierde.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Chats largos, artefactos mezclados y notas ad-hoc dificultan revisar lo que realmente era valioso.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Solución</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Una capa tranquila y organizada.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Repero AI trae conversaciones, documentos y salida generada a un espacio de trabajo estructurado.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Dirección</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Primero europeo por diseño.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Construido alrededor del control, transparencia y portabilidad para que el producto parezca confiable y duradero.</p>
      </article>
    </section>
  </main>
  <Footer lang="es" />
</BaseLayout>
