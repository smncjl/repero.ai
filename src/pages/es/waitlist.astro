---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import Footer from '../../components/Footer.astro';
const submitted = Astro.url.searchParams.get('submitted') === '1';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/es/waitlist', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/waitlist', site).href },
  { lang: 'fr', href: new URL('/fr/liste-attente', site).href },
  { lang: 'de', href: new URL('/de/waitlist', site).href },
  { lang: 'it', href: new URL('/it/lista-attesa', site).href },
  { lang: 'nl', href: new URL('/nl/wachtlijst', site).href }
];
---
<BaseLayout
  lang="es"
  title="Lista de espera | Repero AI"
  description="Únete a la lista de espera para Repero AI."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="es" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Acceso anticipado</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Únete a la beta anticipada.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Ayúdanos a moldear un espacio de trabajo IA primero europeo construido en torno a claridad, control y portabilidad.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Control de datos</span>
          <span class="chip">Transparencia</span>
          <span class="chip">Portabilidad</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Solicitar acceso</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Cuéntanos para qué quieres usarlo.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Usaremos esto para dar prioridad al onboarding adecuado y dirección del producto.</p>
        {submitted ? (
          <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-6">
            <p class="eyebrow">Enviado</p>
            <h3 class="mt-3 text-2xl font-semibold text-white">Estás en la lista de espera.</h3>
            <p class="mt-3 text-sm leading-7 text-emerald-50/90">Tu solicitud ha sido recibida. Te contactaremos cuando haya nuevos espacios disponibles.</p>
          </div>
        ) : (
          <div class="mt-6">
            <WaitlistForm lang="es" />
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer lang="es" />
</BaseLayout>
