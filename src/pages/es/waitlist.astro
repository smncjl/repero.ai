---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = Astro.site?.href || 'https://repero.ai';
const canonical = new URL('/es/waitlist', site).href;
const alternates = [
  { lang: 'en', href: new URL('/en/waitlist', site).href },
  { lang: 'fr', href: new URL('/fr/liste-attente', site).href },
  { lang: 'nl', href: new URL('/nl/waitlist', site).href },
  { lang: 'de', href: new URL('/de/waitlist', site).href },
  { lang: 'it', href: new URL('/it/lista-attesa', site).href }
];
---
<BaseLayout
  lang="es"
  title="Acceso | Repero AI"
  description="Accede a Repero AI ahora."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="es" />
  <main class="page-shell py-10">
    <section class="grid gap-8 md:grid-cols-[1fr_.9fr] md:items-start">
      <div class="surface">
        <p class="eyebrow">Early access</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Accede a Repero AI ahora.</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Repero AI ya está disponible para acceso anticipado en <a href="https://app.repero.ai" class="text-emerald-400 hover:text-emerald-300">app.repero.ai</a>.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">Control de datos</span>
          <span class="chip">Transparencia</span>
          <span class="chip">Portabilidad</span>
        </div>
      </div>
      <div class="surface">
        <p class="eyebrow">Acceso ahora</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">¿Listo para empezar?</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Haz clic abajo para acceder inmediatamente a la plataforma.</p>
        <div class="mt-6">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Acceder a app.repero.ai</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="es" />
</BaseLayout>
