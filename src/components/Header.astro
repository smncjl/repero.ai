---
interface Props { lang: 'en' | 'fr' | 'de' | 'it' | 'es' | 'nl'; }
const { lang } = Astro.props;
const isEn = lang === 'en';
const isFr = lang === 'fr';
const isDe = lang === 'de';
const isIt = lang === 'it';
const isEs = lang === 'es';
const isNl = lang === 'nl';
---
<header class="page-shell py-5">
  <div class="flex items-center justify-between rounded-2xl border border-slate-800/80 bg-slate-950/60 px-4 py-3 shadow-[0_14px_40px_rgba(0,0,0,0.18)] backdrop-blur">
    <a href={isEn ? '/en' : isFr ? '/fr' : isDe ? '/de' : isIt ? '/it' : isEs ? '/es' : '/nl'} class="flex items-center gap-3 text-lg font-bold tracking-tight">
      <img
        src="/brand/repero-icon.svg"
        alt=""
        aria-hidden="true"
        class="h-9 w-9 shrink-0"
        width="36"
        height="36"
      />
      <span>Repero AI</span>
    </a>
    <nav class="flex items-center gap-2 text-sm text-slate-300">
      <a class="rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href={isEn ? '/en/use-cases' : isFr ? '/fr/cas-usages' : isDe ? '/de/use-cases' : isIt ? '/it/use-cases' : isEs ? '/es/use-cases' : '/nl/use-cases'}>{isEn ? 'Use cases' : isFr ? 'Cas d’usage' : isDe ? 'Anwendungsfälle' : isIt ? 'Casi d’uso' : isEs ? 'Casos de uso' : 'Gebruiksscenario’s'}</a>
      {isFr && <a class="rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="/fr/blog">Blog</a>}
      <a class="rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href={isEn ? '/en/waitlist' : isFr ? '/fr/liste-attente' : isDe ? '/de/waitlist' : isIt ? '/it/lista-attesa' : isEs ? '/es/lista-espera' : '/nl/wachtlijst'}>{isEn ? 'Waitlist' : isFr ? 'Liste d\'attente' : isDe ? 'Warteliste' : isIt ? 'Lista d\'attesa' : isEs ? 'Lista de espera' : 'Wachtlijst'}</a>
      <a class="chip ml-1" href={isEn ? '/fr' : isFr ? '/de' : isDe ? '/it' : isIt ? '/es' : isEs ? '/nl' : '/en'}>{isEn ? 'FR' : isFr ? 'DE' : isDe ? 'IT' : isIt ? 'ES' : isEs ? 'NL' : 'EN'}</a>
    </nav>
  </div>
</header>
