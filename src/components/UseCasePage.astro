---
import BaseLayout from '../layouts/BaseLayout.astro';import Header from './Header.astro';import Footer from './Footer.astro';
interface Props { lang:'en'|'fr'; title:string; description:string; items:string[] }
const {lang,title,description,items}=Astro.props;
---
<BaseLayout lang={lang} title={`${title} | Repero AI`} description={description}><Header lang={lang} /><main class="mx-auto max-w-4xl px-6 py-12"><h1 class="text-3xl font-bold">{title}</h1><p class="mt-3 text-lg">{description}</p><ul class="mt-6 list-disc space-y-2 pl-6">{items.map((item)=><li>{item}</li>)}</ul></main><Footer lang={lang} /></BaseLayout>
