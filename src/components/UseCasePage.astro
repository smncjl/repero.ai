---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  lang: 'en' | 'fr';
  title: string;
  description: string;
  items: string[];
}

const { lang, title, description, items } = Astro.props;
---
<BaseLayout lang={lang} title={`${title} | Repero AI`} description={description}>
  <Header lang={lang} />
  <main class="page-shell py-10">
    <section class="surface">
      <p class="eyebrow">Use case</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">{description}</p>
      <ul class="mt-8 grid gap-3 md:grid-cols-2">
        {items.map((item) => (
          <li class="rounded-xl border border-slate-800 bg-slate-950/60 px-4 py-3 text-slate-200">{item}</li>
        ))}
      </ul>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
