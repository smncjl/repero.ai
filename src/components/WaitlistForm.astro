---
interface Props { lang:'en'|'fr'|'de'|'it'|'es'|'nl' }
const { lang } = Astro.props;
const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT || '/api/waitlist';
const isEn = lang === 'en';
const isFr = lang === 'fr';
const isDe = lang === 'de';
const isIt = lang === 'it';
const isEs = lang === 'es';
const isNl = lang === 'nl';
const sendingLabel = isEn ? 'Sending...' : isFr ? 'Envoi...' : isDe ? 'Senden...' : isIt ? 'Invio...' : isEs ? 'Enviando...' : 'Verzenden...';
const successTitle = isEn ? 'Access request received.' : isFr ? 'Demande d’accès reçue.' : isDe ? 'Zugangsanfrage erhalten.' : isIt ? 'Richiesta di accesso ricevuta.' : isEs ? 'Solicitud de acceso recibida.' : 'Toegangsaanvraag ontvangen.';
const successBody = isEn
  ? 'Your request has been received. We’ll follow up with the next access details.'
  : isFr
  ? 'Votre demande a bien été reçue. Nous vous recontacterons avec les prochaines informations d’accès.'
  : isDe
  ? 'Ihre Anfrage wurde empfangen. Wir melden uns mit den nächsten Zugangsinformationen.'
  : isIt
  ? 'La tua richiesta è stata ricevuta. Ti ricontatteremo con le prossime informazioni di accesso.'
  : isEs
  ? 'Su solicitud ha sido recibida. Nos pondremos en contacto con la próxima información de acceso.'
  : 'Je verzoek is ontvangen. We nemen contact met je op met de volgende toegangsgegevens.';
const profiles = isEn
  ? [
      ['personal', 'Personal use'],
      ['independent', 'Independent / freelancer'],
      ['founder', 'Founder / small business'],
      ['developer', 'Developer / technical team'],
      ['data-ops', 'Data / operations team'],
      ['field-technician', 'Tradesperson / field technician'],
      ['student-researcher', 'Student / researcher'],
      ['other', 'Other']
    ]
  : isFr
  ? [
      ['personal', 'Usage personnel'],
      ['independent', 'Indépendant / freelance'],
      ['founder', 'Fondateur / petite entreprise'],
      ['developer', 'Développeur / équipe technique'],
      ['data-ops', 'Data / opérations'],
      ['field-technician', 'Technicien / métier terrain'],
      ['student-researcher', 'Étudiant / recherche'],
      ['other', 'Autre']
    ]
  : isDe
  ? [
      ['personal', 'Persönlicher Gebrauch'],
      ['independent', 'Unabhängig / Freelancer'],
      ['founder', 'Gründer / Kleinstbetrieb'],
      ['developer', 'Entwickler / technisches Team'],
      ['data-ops', 'Daten / Operations-Team'],
      ['field-technician', 'Handwerker / Feldtechniker'],
      ['student-researcher', 'Student / Forscher'],
      ['other', 'Andere']
    ]
  : isIt
  ? [
      ['personal', 'Utilizzo personale'],
      ['independent', 'Indipendente / freelance'],
      ['founder', 'Fondatore / piccola impresa'],
      ['developer', 'Sviluppatore / team tecnico'],
      ['data-ops', 'Dati / team operativo'],
      ['field-technician', 'Artigiano / tecnico sul campo'],
      ['student-researcher', 'Studente / ricercatore'],
      ['other', 'Altro']
    ]
  : isEs
  ? [
      ['personal', 'Uso personal'],
      ['independent', 'Independiente / freelance'],
      ['founder', 'Fundador / pequeña empresa'],
      ['developer', 'Desarrollador / equipo técnico'],
      ['data-ops', 'Datos / equipo operativo'],
      ['field-technician', 'Artesano / técnico de campo'],
      ['student-researcher', 'Estudiante / investigador'],
      ['other', 'Otro']
    ]
  : [
      ['personal', 'Persoonlijk gebruik'],
      ['independent', 'Onafhankelijk / freelancer'],
      ['founder', 'Oprichter / kleine onderneming'],
      ['developer', 'Ontwikkelaar / technisch team'],
      ['data-ops', 'Data / operations team'],
      ['field-technician', 'Handwerker / veldtechnicus'],
      ['student-researcher', 'Student / onderzoeker'],
      ['other', 'Anders']
    ];
---
<div class="grid gap-4" data-waitlist-widget>
  <div class="hidden rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5" data-waitlist-success role="status" aria-live="polite">
    <p class="eyebrow">{isEn ? 'Submitted' : isFr ? 'Envoyé' : isDe ? 'Versendet' : isIt ? 'Inviato' : isEs ? 'Enviado' : 'Verzonden'}</p>
    <h3 class="mt-2 text-xl font-semibold text-white">{successTitle}</h3>
    <p class="mt-2 text-sm leading-7 text-emerald-50/90">{successBody}</p>
  </div>
  <form class="grid gap-4" method="POST" action={endpoint} data-waitlist-form>
    <input class="form-field" type="email" name="email" required placeholder={isEn ? 'Email' : isFr ? 'Email' : isDe ? 'E-Mail' : isIt ? 'Email' : isEs ? 'Correo electrónico' : 'E-mail'} />
    <div style="position:absolute;left:-9999px;" aria-hidden="true">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <input type="hidden" name="language" value={lang} />
    <select class="form-select" name="profile" required>
      <option value="">{isEn ? 'Profile type' : isFr ? 'Type de profil' : isDe ? 'Profiltyp' : isIt ? 'Tipo di profilo' : isEs ? 'Tipo de perfil' : 'Profieltype'}</option>
      {profiles.map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
    <input class="form-field" name="intendedUse" required placeholder={isEn ? 'Intended use' : isFr ? 'Usage prévu' : isDe ? 'Geplanter Gebrauch' : isIt ? 'Utilizzo previsto' : isEs ? 'Uso previsto' : 'Gepland gebruik'} />
    <textarea class="form-field min-h-32" name="message" placeholder={isEn ? 'Optional message' : isFr ? 'Message optionnel' : isDe ? 'Optionale Nachricht' : isIt ? 'Messaggio opzionale' : isEs ? 'Mensaje opcional' : 'Optioneel bericht'}></textarea>
    <button class="btn-primary" type="submit" data-waitlist-submit>{isEn ? 'Request access' : isFr ? 'Demander l’accès' : isDe ? 'Zugang anfragen' : isIt ? 'Richiedi accesso' : isEs ? 'Solicitar acceso' : 'Toegang aanvragen'}</button>
  </form>
</div>

<script is:inline define:vars={{ sendingLabel }}>
  const waitlistWrap = document.querySelector('[data-waitlist-widget]');

  if (waitlistWrap) {
    const form = waitlistWrap.querySelector('[data-waitlist-form]');
    const success = waitlistWrap.querySelector('[data-waitlist-success]');
    const submit = waitlistWrap.querySelector('[data-waitlist-submit]');

    if (form && success && submit) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const submitButton = submit;
        const originalLabel = submitButton.textContent || '';
        submitButton.setAttribute('disabled', 'disabled');
        submitButton.textContent = sendingLabel;

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            credentials: 'same-origin'
          });

          if (!response.ok) {
            throw new Error(`Waitlist submission failed with ${response.status}`);
          }

          form.hidden = true;
          success.classList.remove('hidden');
        } catch (error) {
          console.error('[waitlist] enhanced submit failed, falling back to native submit', error);
          submitButton.removeAttribute('disabled');
          submitButton.textContent = originalLabel;
          form.submit();
          return;
        }

        submitButton.removeAttribute('disabled');
        submitButton.textContent = originalLabel;
      });
    }
  }
</script>
