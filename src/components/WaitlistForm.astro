---
interface Props { lang:'en'|'fr' }
const { lang } = Astro.props;
const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT;
const isEn = lang === 'en';
---
{endpoint ? (
  <form class="grid gap-4" method="POST" action={endpoint}>
    <input class="rounded border p-3" type="email" name="email" required placeholder={isEn ? 'Email' : 'Email'} />
    <input type="hidden" name="language" value={lang} />
    <select class="rounded border p-3" name="profile" required><option value="">{isEn ? 'Profile type' : 'Type de profil'}</option><option>Everyday user</option><option>Developer</option><option>Data team</option><option>Tradesperson / technician</option></select>
    <input class="rounded border p-3" name="intendedUse" required placeholder={isEn ? 'Intended use' : 'Usage prévu'} />
    <textarea class="rounded border p-3" name="message" placeholder={isEn ? 'Optional message' : 'Message optionnel'}></textarea>
    <button class="btn-primary" type="submit">{isEn ? 'Join waitlist' : 'Rejoindre la liste'}</button>
  </form>
) : (
  <p class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-amber-900">{isEn ? 'Waitlist endpoint is not configured yet. Please set PUBLIC_WAITLIST_ENDPOINT.' : 'Le point de soumission n\'est pas configuré. Définissez PUBLIC_WAITLIST_ENDPOINT.'}</p>
)}
