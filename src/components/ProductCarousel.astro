---
import type { ProductScreen } from '../data/frProductScreens';

interface Props {
  id?: string;
  screens: ProductScreen[];
}

const { id, screens } = Astro.props;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const derivedId = screens.map((screen) => slugify(screen.id)).filter(Boolean).join('-');
const fallbackId = `product-carousel-${derivedId || 'screens'}`;
const baseId = slugify(id ?? fallbackId) || fallbackId;
---

{
  screens.length > 0 && (
    <section class="product-carousel surface" data-product-carousel data-carousel-id={baseId}>
      <div class="product-carousel__tabs" role="tablist" aria-label="Captures produit">
        {screens.map((screen, index) => {
          const panelId = `${baseId}-panel-${index + 1}`;
          const tabId = `${baseId}-tab-${index + 1}`;
          const isActive = index === 0;

          return (
            <button
              id={tabId}
              class="product-carousel__tab"
              type="button"
              role="tab"
              aria-selected={isActive ? 'true' : 'false'}
              aria-controls={panelId}
              tabindex={isActive ? '0' : '-1'}
              data-carousel-tab
            >
              <img
                src={screen.image}
                alt=""
                aria-hidden="true"
                class="product-carousel__thumb"
                width="96"
                height="64"
                loading="lazy"
              />
              <span class="product-carousel__tab-body">
                <span class="product-carousel__tab-title">{screen.title}</span>
                <span class="product-carousel__tab-copy">{screen.description}</span>
              </span>
            </button>
          );
        })}
      </div>

      <div class="product-carousel__panels">
        {screens.map((screen, index) => {
          const panelId = `${baseId}-panel-${index + 1}`;
          const tabId = `${baseId}-tab-${index + 1}`;
          const isActive = index === 0;

          return (
            <article
              id={panelId}
              class="product-carousel__panel"
              role="tabpanel"
              aria-labelledby={tabId}
              tabindex={0}
              hidden={!isActive}
              data-carousel-panel
            >
              <div class="product-carousel__frame">
                <img
                  src={screen.image}
                  alt={screen.alt}
                  class="product-carousel__image"
                  width="1440"
                  height="960"
                  loading={isActive ? 'eager' : 'lazy'}
                />
              </div>
              <div class="product-carousel__content">
                <h3 class="product-carousel__title">{screen.title}</h3>
                <p class="product-carousel__description">{screen.description}</p>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )
}

<script>
  const selectTab = (tabs, panels, nextIndex, moveFocus) => {
    tabs.forEach((tab, index) => {
      const isActive = index === nextIndex;
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      tab.setAttribute('tabindex', isActive ? '0' : '-1');

      if (moveFocus && isActive) {
        tab.focus();
      }
    });

    panels.forEach((panel, index) => {
      panel.hidden = index !== nextIndex;
    });
  };

  const bindCarousel = (root) => {
    if (root.dataset.carouselBound === 'true') {
      return;
    }

    const tabs = Array.from(root.querySelectorAll('[data-carousel-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-carousel-panel]'));

    if (tabs.length === 0 || tabs.length !== panels.length) {
      return;
    }

    root.dataset.carouselBound = 'true';

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        selectTab(tabs, panels, index, false);
      });

      tab.addEventListener('keydown', (event) => {
        const lastIndex = tabs.length - 1;
        let nextIndex = null;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = index === lastIndex ? 0 : index + 1;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex = index === 0 ? lastIndex : index - 1;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = lastIndex;
        }

        if (nextIndex === null) {
          return;
        }

        event.preventDefault();
        selectTab(tabs, panels, nextIndex, true);
      });
    });
  };

  document.querySelectorAll('[data-product-carousel]').forEach((root) => {
    bindCarousel(root);
  });
</script>
