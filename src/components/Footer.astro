---
interface Props { lang: 'en' | 'fr'; }
const { lang } = Astro.props;
---
<footer class="page-shell mt-16 pb-10">
  <div class="flex flex-col gap-3 border-t border-slate-800 pt-6 text-sm text-slate-400 md:flex-row md:items-center md:justify-between">
    <p>{lang === 'en' ? 'European-first AI workspace. Built with data control, transparency and portability in mind.' : 'Espace de travail IA européen. Conçu avec contrôle des données, transparence et portabilité en tête.'}</p>
    <p class="text-slate-500">Repero AI</p>
  </div>
</footer>
