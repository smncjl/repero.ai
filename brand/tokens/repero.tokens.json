{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "Repero AI",
    "version": "1.0.0"
  },
  "color": {
    "ink": { "$type": "color", "$value": "#0B1531" },
    "inkStrong": { "$type": "color", "$value": "#050A1C" },
    "surface": { "$type": "color", "$value": "#F8FCFF" },
    "surfaceRaised": { "$type": "color", "$value": "#FFFFFF" },
    "surfaceDark": { "$type": "color", "$value": "#050A1C" },
    "text": { "$type": "color", "$value": "#0B1531" },
    "textOnDark": { "$type": "color", "$value": "#F4FBFF" },
    "textMuted": { "$type": "color", "$value": "#52617A" },
    "line": { "$type": "color", "$value": "#D8E4EE" },
    "accent": { "$type": "color", "$value": "#22D3EE" },
    "accentSoft": { "$type": "color", "$value": "#CFFAFE" },
    "accentBright": { "$type": "color", "$value": "#67E8F9" }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" },
    "10": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "18px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Inter", "Arial", "sans-serif"] },
    "weightRegular": { "$type": "fontWeight", "$value": 400 },
    "weightMedium": { "$type": "fontWeight", "$value": 500 },
    "weightSemibold": { "$type": "fontWeight", "$value": 600 },
    "weightBold": { "$type": "fontWeight", "$value": 700 },
    "sizeBody": { "$type": "dimension", "$value": "16px" },
    "sizeLabel": { "$type": "dimension", "$value": "14px" },
    "sizeTitle": { "$type": "dimension", "$value": "48px" },
    "lineHeightBody": { "$type": "number", "$value": 1.5 },
    "lineHeightTitle": { "$type": "number", "$value": 1.08 },
    "trackingDisplay": { "$type": "number", "$value": -0.03 }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "color": "#0B15311A", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" } },
    "md": { "$type": "shadow", "$value": { "color": "#0B15311F", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-8px" } },
    "lg": { "$type": "shadow", "$value": { "color": "#050A1C29", "offsetX": "0px", "offsetY": "20px", "blur": "48px", "spread": "-16px" } }
  }
}
