{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Repero AI brand token proposal",
    "status": "proposed-documentation-only",
    "source": "docs/brand-audit.md",
    "implementation": "Not wired into product code. Existing Tailwind utilities and inline CSS remain unchanged.",
    "scope": "Primary chat UI, authentication, and billing templates; Django admin excluded from brand normalization."
  },
  "existing": {
    "implementation": {
      "styling": "Tailwind CDN default palette plus inline template CSS",
      "darkMode": "class strategy, initialized from system preference",
      "fontSans": "Tailwind/browser default sans-serif stack; no custom font loaded",
      "fontMono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New"
    },
    "colors": {
      "slate": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      },
      "sky": {
        "50": "#f0f9ff",
        "100": "#e0f2fe",
        "200": "#bae6fd",
        "300": "#7dd3fc",
        "400": "#38bdf8",
        "500": "#0ea5e9",
        "600": "#0284c7",
        "700": "#0369a1",
        "800": "#075985",
        "900": "#0c4a6e",
        "950": "#082f49"
      },
      "semantic": {
        "success": { "light": "#ecfdf5", "strong": "#047857", "dark": "#022c22" },
        "warning": { "light": "#fffbeb", "strong": "#d97706", "dark": "#451a03" },
        "error": { "light": "#fff1f2", "strong": "#be123c", "dark": "#4c0519" }
      },
      "incidental": {
        "billingGlowCyan": "#22d3ee at 10% alpha"
      }
    },
    "radius": {
      "sm": "0.125rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem",
      "2xl": "1rem",
      "authInput": "0.9rem",
      "authCard": "1.5rem",
      "billingPlan": "1.5rem",
      "billingUsage": "1.75rem",
      "billingShell": "2rem",
      "full": "9999px"
    },
    "spacingPx": [4, 8, 12, 16, 20, 24, 32, 40],
    "typography": {
      "micro": "10px",
      "label": "11px",
      "small": "12px",
      "body": "14px / 20px",
      "heading": ["24px", "30px", "36px"],
      "emphasis": [500, 600, 700],
      "labelTracking": ["0.025em", "0.2em", "0.22em", "0.3em"]
    }
  },
  "proposedNormalized": {
    "note": "These names are proposals mapped to existing values. They do not authorize value changes or code integration.",
    "color": {
      "canvas": { "light": "#f1f5f9", "dark": "#020617" },
      "surface": { "baseLight": "#ffffff", "subtleLight": "#f8fafc", "baseDark": "#0f172a", "strongDark": "#020617" },
      "border": { "light": "#cbd5e1", "subtleLight": "#e2e8f0", "dark": "#334155", "subtleDark": "#1e293b" },
      "text": { "primaryLight": "#0f172a", "secondaryLight": "#64748b", "primaryDark": "#f1f5f9", "secondaryDark": "#94a3b8" },
      "action": { "default": "#0284c7", "hover": "#0ea5e9", "soft": "#e0f2fe", "onDark": "#bae6fd" },
      "status": {
        "success": { "surface": "#ecfdf5", "content": "#047857", "surfaceDark": "#022c22" },
        "warning": { "surface": "#fffbeb", "content": "#d97706", "surfaceDark": "#451a03" },
        "error": { "surface": "#fff1f2", "content": "#be123c", "surfaceDark": "#4c0519" }
      }
    },
    "radius": {
      "control": "0.5rem",
      "compact": "0.375rem",
      "panel": "0.75rem",
      "container": "1rem",
      "feature": "1.5rem",
      "hero": "2rem",
      "pill": "9999px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px"
    },
    "typography": {
      "fontFamily": { "ui": "inherit (existing browser/Tailwind sans stack)", "code": "existing system monospace stack" },
      "size": { "micro": "10px", "label": "11px", "small": "12px", "body": "14px", "title": "24px", "display": "36px" },
      "weight": { "medium": 500, "semibold": 600, "bold": 700 },
      "tracking": { "utility": "0.025em", "eyebrow": "0.22em" }
    },
    "geometryRules": [
      "Use compact radii for controls, panel radii for grouped UI, container radii for message bubbles and primary cards, and pill radius only for compact metadata/status.",
      "Keep nested layers visibly related by stepping down in radius and spacing.",
      "Do not derive logo geometry from these tokens; official logo geometry is frozen and absent from this repository."
    ]
  }
}
